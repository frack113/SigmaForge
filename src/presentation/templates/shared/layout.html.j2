{# Shared layout for all app pages #}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="light dark">
    <title>{% block title %}SigmaHQ RAG{% endblock %}</title>
    <link rel="icon" type="image/x-icon" href="{{ url_for('static', path='/favicon.ico') }}">
    <script>!function(){var t=localStorage.getItem("sigmahqrag-theme");if(t==="dark"){document.documentElement.setAttribute("data-theme","dark")}}()</script>
    <link rel="stylesheet" href="{{ url_for('static', path='/css/base/theme.css') }}">
    <link rel="stylesheet" href="{{ url_for('static', path='/css/base/reset.css') }}">
    <link rel="stylesheet" href="{{ url_for('static', path='/css/base/typography.css') }}">
    <link rel="stylesheet" href="{{ url_for('static', path='/css/layout/header-nav.css') }}">
    <link rel="stylesheet" href="{{ url_for('static', path='/css/layout/app-layout.css') }}">
    <link rel="stylesheet" href="{{ url_for('static', path='/css/layout/sidebar.css') }}">
    <link rel="stylesheet" href="{{ url_for('static', path='/css/layout/main-content.css') }}">
    <link rel="stylesheet" href="{{ url_for('static', path='/css/components/buttons.css') }}">
    <link rel="stylesheet" href="{{ url_for('static', path='/css/components/cards.css') }}">
    <link rel="stylesheet" href="{{ url_for('static', path='/css/components/forms.css') }}">
    <link rel="stylesheet" href="{{ url_for('static', path='/css/components/tables.css') }}">
    <link rel="stylesheet" href="{{ url_for('static', path='/css/components/modals.css') }}">
    <link rel="stylesheet" href="{{ url_for('static', path='/css/components/progress-bar.css') }}">
    <link rel="stylesheet" href="{{ url_for('static', path='/css/components/status.css') }}">
    <link rel="stylesheet" href="{{ url_for('static', path='/css/components/toasts.css') }}">
    <link rel="stylesheet" href="{{ url_for('static', path='/css/base/utilities.css') }}">
    {% block styles %}{% endblock %}
</head>
<body class="{% block body_class %}{% endblock %}">
    {% include 'shared/_header.html.j2' %}

    {# Page-specific sidebar layout #}
    <div class="app-layout">
        {# Page sidebar (default: override in child templates) #}
        <aside class="app-sidebar">
            {% block sidebar %}
            <div class="sidebar-header">
                <h2>{% block sidebar_title %}Menu{% endblock %}</h2>
                <p>{% block sidebar_subtitle %}{% endblock %}</p>
            </div>
            <nav class="sidebar-nav">
                {% block sidebar_nav %}{% endblock %}
            </nav>
            {% endblock %}
        </aside>

        {# Main content #}
        <main class="app-content">
            {% block content %}{% endblock %}
        </main>
    </div>

    <div id="toast-container" class="toast-container"></div>

    {% block footer %}
    <footer>
        <p>&copy; 2026 SigmaHQ RAG — Local RAG for Sigma Rules</p>
    </footer>
    {% endblock %}

    <script src="{{ url_for('static', path='/js/internal/notifications.js') }}"></script>
    <script src="{{ url_for('static', path='/js/internal/theme.js') }}"></script>
    <script>
    (() => {
        const ALERT_ID = "service-alert";

        function updateServiceAlert() {
            const alertEl = document.getElementById(ALERT_ID);
            if (!alertEl) return;

            fetch("/api/v1/admin/status", { signal: AbortSignal.timeout(5000) })
                .then(r => r.json())
                .then(data => {
                    const services = data?.data || {};
                    const allActive = Object.values(services).every(
                        s => s?.status === "active"
                    );
                    alertEl.style.display = allActive ? "none" : "";
                })
                .catch(() => {
                    // On error (network, timeout) keep current state
                });
        }

        document.addEventListener("DOMContentLoaded", () => {
            updateServiceAlert();
            setInterval(updateServiceAlert, 30000);
        });
    })();
    </script>
    {% block scripts %}{% endblock %}
</body>
</html>
