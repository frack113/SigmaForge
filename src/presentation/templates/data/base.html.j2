{# Data section layout - extends shared layout #}
{% extends "shared/layout.html.j2" %}

{% block title %}Data Sources — SigmaForge{% endblock %}

{% block styles %}
{{ super() }}
{% endblock %}

{% block scripts %}
{{ super() }}
<script src="{{ url_for('static', path='/js/internal/dir_browser.js') }}"></script>
{% endblock %}

{% block sidebar_title %}Data Sources{% endblock %}
{% block sidebar_subtitle %}Manage your data{% endblock %}

{% block sidebar_nav %}
<a href="/data/sigma-spec" {% if '/data/sigma-spec' in request.url.path %}class="active"{% endif %}>Sigma Spec</a>
<a href="/data/github" {% if '/data/github' in request.url.path %}class="active"{% endif %}>GitHub</a>
<a href="/data/local" {% if '/data/local' in request.url.path %}class="active"{% endif %}>Local Files</a>
<a href="/data/vectordb" {% if '/data/vectordb' in request.url.path %}class="active"{% endif %}>Vector DB</a>
<a href="/data/prompts" {% if '/data/prompts' in request.url.path %}class="active"{% endif %}>Prompts</a>
{% endblock %}

{% block content %}
{% block page_content %}{% endblock %}
{% endblock %}
