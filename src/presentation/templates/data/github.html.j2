{% extends "data/base.html.j2" %}
{% from "shared/_repo_section.html.j2" import repo_section %}

{% block title %}GitHub Repositories — SigmaHQ RAG{% endblock %}

{% block page_content %}
<h1>GitHub Repositories</h1>
<p>Manage GitHub repositories for Sigma rule indexing.</p>

{{ repo_section(
    intro_text="Click \"Browse\" on a repository to view and select directories for indexing.",
    modal_h2="Add GitHub Repository",
    url_placeholder="SigmaHQ/sigma",
    dir_browser_id="github",
    dir_browser_title="Select Directories to Index"
) }}
{% endblock %}

{% block scripts %}
{{ super() }}
<script src="{{ url_for('static', path='/js/internal/repo-browser.js') }}"></script>
<script src="{{ url_for('static', path='/js/internal/github.js') }}"></script>
{% endblock %}

{% block styles %}
{{ super() }}
{% endblock %}
