{% extends "data/base.html.j2" %}

{% block title %}Vector DB — SigmaForge{% endblock %}

{% block page_content %}
<h1 class="mb-4">Vector Database</h1>
<p class="text-muted">Qdrant vector database status and collection management.</p>

<div id="vectordb-loading" class="vectordb-loading">
    <p>Loading Vector DB status...</p>
</div>

<div id="vectordb-error" class="vectordb-error" style="display:none;">
    <p>Failed to load Vector DB status.</p>
    <button class="btn btn-primary" onclick="loadVectorDB()">Retry</button>
</div>

<div id="vectordb-content" style="display:none;">
    
    <!-- Collections Card -->
    <div class="card w-100">
        <div class="card-header">
            <h2>Collections</h2>
        </div>
        <div class="card-body">
            <table class="table table-hover w-100" id="collections-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Status</th>
                        <th>Points (Approx)</th>
                        <th>Shards</th>
                        <th>Vectors Config</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="collections-list">
                    <!-- Dynamic rows here -->
                </tbody>
            </table>
        </div>
    </div>

    <!-- Unified Indexer Card -->
    <div class="card w-100" id="indexer-card">
        <div class="card-header">
            <h2>Index Pending Documents</h2>
        </div>
        <div class="card-body">
            <p>Scans doc_registry and sigma_spec tables to index unprocessed files into Qdrant.</p>

            <div id="indexer-progress-spec" class="progress-bar-container" >
                <div class="progress-label">Specification (<span id="indexer-progress-spec-text">Pending</span>)</div>
                <div class="progress-blue-gradient">
                    <div class="progress-fill" id="indexer-progress-spec-fill" style="width:0%"></div>
                </div>
            </div>

            <div id="indexer-progress-docs" class="progress-bar-container">
                <div class="progress-label">Documents (<span id="indexer-progress-docs-text">Pending</span>)</div>
                <div class="progress-blue-gradient">
                    <div class="progress-fill" id="indexer-progress-docs-fill" style="width:0%"></div>
                </div>
            </div>

            <div id="indexer-result" class="vectordb-message" ></div>
            <div id="indexer-error" class="vectordb-message" style="display:none;color:var(--color-danger);"></div>
        </div>
        <div class="card-footer vectordb-card-actions">
            <button class="btn btn-success" id="btn-index-docs" onclick="startUnifiedIndex()">Indexer</button>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
{{ super() }}
<script src="{{ url_for('static', path='/js/internal/progress-bar.js') }}"></script>
<script src="{{ url_for('static', path='/js/internal/qdrant.js') }}"></script>
<script src="{{ url_for('static', path='/js/internal/vectordb.js') }}"></script>
{% endblock %}


