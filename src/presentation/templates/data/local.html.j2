{% extends "data/base.html.j2" %}

{% block title %}Local Files — SigmaHQ RAG{% endblock %}

{% block styles %}
{{ super() }}
<link rel="stylesheet" href="{{ url_for('static', path='/css/base/local.css') }}">
{% endblock %}

{% block page_content %}
<h1>Local Files</h1>
<p>Upload and manage local Sigma detection rules for RAG processing.</p>

<div class="file-stats-grid">
    <div class="stat-card">
        <div class="stat-value" id="total-count">0</div>
        <div class="stat-label">Total Files</div>
    </div>
    <div class="stat-card">
        <div class="stat-value" id="pending-count">0</div>
        <div class="stat-label">Pending Embedding</div>
    </div>
    <div class="stat-card">
        <div class="stat-value" id="embedded-count">0</div>
        <div class="stat-label">Embedded in Vector DB</div>
    </div>
</div>

<div class="upload-section" id="upload-zone" tabindex="0" role="button" aria-label="Drag & drop or activate to upload files">
    <h3>📁 Drag & Drop files here</h3>
    <p>or click to browse (supported: .md, .txt, .yml, .yaml, .json, etc.)</p>
    <input type="file" id="file-input" multiple accept=".md,.txt,.yml,.yaml,.json,.csv,.toml">
</div>

<div id="upload-progress">
    <div id="status-message">Uploading...</div>
    <div class="progress-bar">
        <div class="progress-fill" id="progress-fill"></div>
    </div>
</div>

<script src="{{ url_for('static', path='/js/internal/progress-bar.js') }}"></script>

<div class="files-table">
    <table>
        <thead>
            <tr>
                <th>Name</th>
                <th>Type</th>
                <th>Size</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody id="local-files-body">
            <tr>
                <td colspan="5" class="empty-state">Loading files...</td>
            </tr>
        </tbody>
    </table>
</div>
{% endblock %}

{% block scripts %}
<script src="{{ url_for('static', path='/js/internal/local.js') }}"></script>
{% endblock %}