{% extends "data/base.html.j2" %}

{% block title %}Prompts — SigmaHQ RAG{% endblock %}

{% block content %}
<div class="card">
    <div class="card-header">
        <h2>Prompts List</h2>
        <div>
            <button class="btn btn-sm btn-success" onclick="syncFromFiles()">Sync from files</button>
            <button class="btn btn-sm btn-primary" onclick="EnableEditForm()">Add new</button>
            <button class="btn btn-sm btn-secondary" onclick="refreshList()">Refresh list</button>
        </div>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>Description</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody id="prompts-table-body">
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="card" id="prompt-form-container">
    <div class="card-header">
        <h2 id="edit-form-title">Edit Prompt</h2>
    </div>
    <div class="card-body">
        <div class="form-group">
            <label for="prompt-id">ID:</label>
            <input type="text" id="prompt-id" placeholder="UUID will be generated" readonly>
        </div>
        <div class="form-group">
            <label for="prompt-name">Name (kebab-case, max 25):</label>
            <input type="text" id="prompt-name" placeholder="ex: analyste-sigma" maxlength="25" disabled>
        </div>
        <div class="form-group">
            <label for="prompt-description">Description (max 100):</label>
            <input type="text" id="prompt-description" placeholder="Brief description..." maxlength="100" disabled>
        </div>
        <div class="form-group">
            <label for="prompt-content-input">Content (Markdown):</label>
            <textarea id="prompt-content-input" rows="10" placeholder="Enter prompt content..." style="width:100%; min-height:250px; resize:vertical;" disabled></textarea>
        </div>
        <div class="card-footer">
            <button class="btn btn-secondary" id="btn-cancel" onclick="resetForm()" disabled>Cancel</button>
            <button class="btn btn-primary" id="btn-save" onclick="savePrompt()" disabled>Save Prompt</button>
        </div>
        <div id="save-status" class="card-spacing status-message" role="status" aria-live="polite"></div>
    </div>
</div>

<script src="{{ url_for('static', path='/js/internal/prompts.js') }}"></script>

{% endblock %}
