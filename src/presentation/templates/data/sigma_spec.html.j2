{% extends "data/base.html.j2" %}
{% from "shared/_repo_section.html.j2" import repo_section %}

{% block title %}Specification Repositories — SigmaHQ RAG{% endblock %}

{% block page_content %}
<h1>Specification Repositories</h1>
<p>Manage GitHub repositories for Sigma specification indexing.</p>

{{ repo_section(
    intro_text="Click \"Browse\" on a repository to view and select directories for indexing.",
    modal_h2="Add Specification Repository",
    url_placeholder="SigmaHQ/sigma-specification",
    dir_browser_id="spec",
    dir_browser_title="Select Directories to Index"
) }}
{% endblock %}

{% block scripts %}
{{ super() }}
<script src="{{ url_for('static', path='/js/internal/repo-browser.js') }}"></script>
<script src="{{ url_for('static', path='/js/internal/sigma-spec.js') }}"></script>
{% endblock %}

{% block styles %}
{{ super() }}
<style>
.repo-info { padding: 1rem; }
.repo-info h3 { margin-top: 0; }
.error-message { color: var(--color-danger); padding: 0.75rem; text-align: center; background: var(--chat-message-error-bg); border-radius: 4px; }
.table { width: 100%; border-collapse: collapse; margin-top: 0.5rem; }
.table th, .table td { padding: 0.5rem; text-align: left; border-bottom: 1px solid var(--border-card); }
.table th { font-weight: 600; }
</style>
{% endblock %}