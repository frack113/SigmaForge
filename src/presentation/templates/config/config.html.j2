{# Config Dashboard — sections with side-by-side cards #}
{% extends "config/layout.html.j2" %}

{% block title %}Config — SigmaHQ RAG{% endblock %}

{% block styles %}
<link rel="stylesheet" href="{{ url_for('static', path='/css/config.css') }}">
{% endblock %}

{% block content %}
<div class="config-dashboard">
    <!-- Status Banner -->
    <div class="config-hero-banner" id="status-banner">
        <div class="hero-content">
            <h1>System Status</h1>
            <p>Real-time overview of all services</p>
            <div class="status-grid" id="status-grid">
                <div class="status-card status-card-loading" data-service="llama">
                    <div class="status-dot"></div>
                    <span class="status-label">llama.cpp</span>
                    <span class="status-text">Loading...</span>
                </div>
                <div class="status-card status-card-loading" data-service="qdrant">
                    <div class="status-dot"></div>
                    <span class="status-label">Qdrant</span>
                    <span class="status-text">Loading...</span>
                </div>
                <div class="status-card status-card-loading" data-service="duckdb">
                    <div class="status-dot"></div>
                    <span class="status-label">DuckDB</span>
                    <span class="status-text">Loading...</span>
                </div>
                <div class="status-card status-card-loading" data-service="logging">
                    <div class="status-dot"></div>
                    <span class="status-label">Logging</span>
                    <span class="status-text">Loading...</span>
                </div>
            </div>
        </div>
    </div>

    <div class="config-dashboard">
            <!-- Section: General -->
            <details class="config-group" id="general-section" open>
                <summary class="config-group-summary">General</summary>
                <div class="config-cards">
                    <!-- Configuration Card -->
                    <div class="card">
                        <div class="card-header"><h2>Configuration</h2><button type="submit" form="config-form" class="btn btn-primary btn-sm">Save</button></div>
                        <div class="card-body">
                            <form id="config-form">
                                <div class="config-row">
                                    <div class="form-group inline">
                                        <label for="os-select">OS:</label>
                                        <select id="os-select" name="os">
                                            <option value="windows">Windows</option>
                                            <option value="linux">Linux</option>
                                            <option value="macos">macOS</option>
                                        </select>
                                    </div>
                                    <div class="form-group inline">
                                        <label for="gpu-select">GPU Backend:</label>
                                        <select id="gpu-select" name="gpu">
                                            <option value="cpu">CPU</option>
                                            <option value="cuda">CUDA</option>
                                            <option value="hip">HIP (AMD)</option>
                                            <option value="vulkan">Vulkan</option>
                                        </select>
                                    </div>
                                </div>
                            </form>
                            <div id="config-status" class="status-message"></div>
                        </div>
                    </div>
                    <!-- Logging Card -->
                    <div class="card">
                        <div class="card-header"><h2>Logging</h2><button class="btn btn-primary btn-sm" onclick="Config.saveLoggingConfig()">Save</button></div>
                        <div class="card-body">
                            <div id="logging-status" class="global-status">
                                <span class="status-dot"></span>
                                <span id="logging-status-text">Loading...</span>
                            </div>
                            <div class="config-row mt-3">
                                <div class="form-group inline">
                                    <label for="log-level-select">Log Level</label>
                                    <select id="log-level-select">
                                        <option value="DEBUG">DEBUG</option>
                                        <option value="INFO" selected>INFO</option>
                                        <option value="WARNING">WARNING</option>
                                        <option value="ERROR">ERROR</option>
                                        <option value="CRITICAL">CRITICAL</option>
                                    </select>
                                </div>
                                <div class="form-group inline">
                                    <label for="log-max-size-input">Max Size</label>
                                    <input type="text" id="log-max-size-input" value="10M" placeholder="10M" maxlength="5" class="w-80">
                                </div>
                                <div class="form-group inline">
                                    <label for="log-max-file-input">Max Files</label>
                                    <input type="number" id="log-max-file-input" value="5" min="1" max="99" class="w-70">
                                </div>
                            </div>
                                <div class="config-row">
                                <span class="text-sm" style="color:var(--text-body);margin-right:var(--space-2);">Clean at startup</span>
                                <label class="toggle" id="log-clean-toggle">
                                    <input type="checkbox" id="log-clean-at-startup">
                                    <span class="toggle-track"></span>
                                    <span class="theme-text-label" id="log-clean-label">No</span>
                                </label>
                            </div>
                            <div id="logging-config-status" class="status-message"></div>
                        </div>
                    </div>
                </div>
            </details>

            <!-- Section: Storage -->
            <details class="config-group" id="data-section" open>
                <summary class="config-group-summary">Storage</summary>
                <div class="config-cards">
                    <!-- Storage Card -->
                    <div class="card card-flex-2">
                        <div class="card-header"><h2>Storage</h2></div>
                        <div class="card-body">
                            <div id="data-global-status" class="global-status"></div>
                            <div id="data-dirs-list" class="mt-3"></div>
                            <div id="duckdb-status" class="mt-3"></div>
                        </div>
                    </div>
                    <!-- Specifications Card -->
                    <div class="card card-flex-1">
                        <div class="card-header"><h2>Spécifications</h2></div>
                        <div class="card-body">
                            <div id="specs-status" class="global-status">
                                <span class="status-dot"></span>
                                <span id="specs-status-text">Loading...</span>
                            </div>
                            <div id="specs-repos-list" class="mt-3"></div>
                            <div id="specs-config-status" class="status-message"></div>
                        </div>
                    </div>
                </div>
            </details>

            <!-- Section: Backend -->
            <details class="config-group" id="backend-section" open>
                <summary class="config-group-summary">Backend</summary>
                <div class="config-cards">
                    <!-- Releases Management Card -->
                    <div class="card card-full">
                        <div class="card-header"><h2>Releases Management</h2></div>
                        <div class="card-body">
                        <div id="releases-timestamp" class="text-sm mb-4" style="color:var(--text-card-body);">
                            Last update: <span id="releases-last-update">—</span>
                        </div>
                        <div id="releases-table" class="mt-2">
                            <!-- Releases table will be populated here -->
                        </div>
                        <div class="flex-row mt-3">
                            <button class="btn btn-primary btn-sm" onclick="Config.refreshReleases()">Refresh GitHub Releases</button>
                            <button class="btn btn-secondary btn-sm" onclick="Config.scanLocalVersions()">Scan Local Versions</button>
                        </div>
                        <div id="releases-refresh-status" class="status-message mt-2"></div>
                        </div>
                    </div>
                    <!-- Qdrant Card -->
                    <div class="card">
                        <div class="card-header"><h2>Qdrant</h2><button class="btn btn-primary btn-sm" onclick="Config.saveBackendServiceConfig('qdrant')">Save</button></div>
                        <div class="card-body">
                            <div class="config-row mb-3">
                                <div class="form-group inline">
                                    <label for="qdrant-base-url">Base URL</label>
                                    <input type="text" id="qdrant-base-url" value="http://127.0.0.1:6333" placeholder="http://127.0.0.1:6333">
                                </div>
                            </div>

                            <div class="config-row mb-3">
                                <div class="form-group inline">
                                    <label>Manage</label>
                                    <label class="toggle" id="qdrant-mode-toggle">
                                        <input type="checkbox" id="qdrant-manage-internally" checked onchange="Config.onQdrantModeChange()">
                                        <span class="toggle-track"></span>
                                        <span class="theme-text-label" id="qdrant-mode-label">Internal</span>
                                    </label>
                                </div>
                            </div>

                            <div class="config-row mb-3">
                                <div class="form-group inline">
                                    <label>Auto start</label>
                                    <label class="toggle" id="qdrant-autostart-toggle">
                                        <input type="checkbox" id="qdrant-autorun-at-startup" checked onchange="Config.onQdrantAutostartChange()">
                                        <span class="toggle-track"></span>
                                        <span class="theme-text-label" id="qdrant-autostart-label">Off</span>
                                    </label>
                                </div>
                            </div>

                            <div id="qdrant-status" class="status-row mb-4">
                                <span class="status-dot status-unknown"></span>
                                <span id="qdrant-status-text">Inactive</span>
                                <button class="btn btn-secondary btn-sm" onclick="Config.loadBackendStatus()">Refresh</button>
                                <button id="qdrant-start-btn" class="btn btn-success btn-sm" onclick="Config.startService('qdrant')">Start</button>
                                <button id="qdrant-stop-btn" class="btn btn-danger btn-sm" onclick="Config.stopService('qdrant')">Stop</button>
                                <a id="qdrant-webui-link" href="http://127.0.0.1:6333/dashboard" target="_blank" class="btn btn-secondary btn-sm">Web UI</a>
                            </div>

                            <div class="config-row mb-4">
                                <div class="form-group inline">
                                    <label>Binary:</label>
                                    <select id="qdrant-release-select" class="min-w-200"></select>
                                </div>
                                <button id="qdrant-download-btn" class="btn btn-primary btn-sm" onclick="Config.downloadQdrantBinary()">Update</button>
                            </div>

                            <div class="config-row mb-4">
                                <div class="form-group inline">
                                    <label>UI Version:</label>
                                    <select id="qdrant-ui-release-select" class="min-w-200"></select>
                                </div>
                                <button id="qdrant-ui-download-btn" class="btn btn-primary btn-sm" onclick="Config.downloadQdrantUI()">Download Web UI</button>
                            </div>

                            <div id="qdrant-download-status" class="status-message"></div>
                            <div id="qdrant-progress-container" class="d-none">
                                <div class="progress-bar"><div class="progress-fill" id="qdrant-progress-fill"></div></div>
                                <p id="qdrant-progress-text">Downloading...</p>
                            </div>

                        </div>
                    </div>
                    <!-- llama.cpp Card -->
                    <div class="card">
                        <div class="card-header"><h2>llama.cpp</h2><button class="btn btn-primary btn-sm" onclick="Config.saveBackendServiceConfig('llama')">Save</button></div>
                        <div class="card-body">
                            <div class="config-row mb-3">
                                <div class="form-group inline">
                                    <label for="llama-base-url">Base URL</label>
                                    <input type="text" id="llama-base-url" value="http://127.0.0.1:8080" placeholder="http://127.0.0.1:8080">
                                </div>
                            </div>

                            <div class="config-row mb-3">
                                <div class="form-group inline">
                                    <label>Manage</label>
                                    <label class="toggle" id="llama-mode-toggle">
                                        <input type="checkbox" id="llama-manage-internally" checked onchange="Config.onLlamaModeChange()">
                                        <span class="toggle-track"></span>
                                        <span class="theme-text-label" id="llama-mode-label">Internal</span>
                                    </label>
                                </div>
                            </div>

                            <div class="config-row mb-3">
                                <div class="form-group inline">
                                    <label>Auto start</label>
                                    <label class="toggle" id="llama-autostart-toggle">
                                        <input type="checkbox" id="llama-autorun-at-startup" checked onchange="Config.onLlamaAutostartChange()">
                                        <span class="toggle-track"></span>
                                        <span class="theme-text-label" id="llama-autostart-label">Off</span>
                                    </label>
                                </div>
                            </div>

                            <div id="llama-status" class="status-row mb-4">
                                <span class="status-dot status-unknown"></span>
                                <span id="llama-status-text">Inactive</span>
                                <button class="btn btn-secondary btn-sm" onclick="Config.loadBackendStatus()">Refresh</button>
                                <button id="llama-start-btn" class="btn btn-success btn-sm" onclick="Config.startService('llama')">Start</button>
                                <button id="llama-stop-btn" class="btn btn-danger btn-sm" onclick="Config.stopService('llama')">Stop</button>
                            </div>

                            <div class="config-row mb-4">
                                <div class="form-group inline">
                                    <label>Release:</label>
                                    <select id="llama-release-select" class="min-w-200"></select>
                                </div>
                                <button id="llama-download-btn" class="btn btn-primary btn-sm" onclick="Config.downloadLlama()">Update</button>
                            </div>

                            <div id="llama-download-status" class="status-message"></div>
                            <div id="llama-progress-container" class="d-none">
                                <div class="progress-bar"><div class="progress-fill" id="llama-progress-fill"></div></div>
                                <p id="llama-progress-text">Downloading...</p>
                            </div>

                        </div>
                    </div>
                </div>
            </details>

            <!-- Section: Model -->
            <details class="config-group" id="model-section" open>
                <summary class="config-group-summary">Model</summary>
                <div class="config-cards">
                    <!-- Embedding E5 Card (dense) -->
                    <div class="card">
                        <div class="card-header"><h2>Embedding E5</h2></div>
                        <div id="emb-dim-banner" class="alert-warning-dim d-none">
                            <strong>Dimension mismatch:</strong> The active embedding model dimension (<span id="emb-model-dim"></span>) differs from the Qdrant collection (<span id="emb-coll-dim"></span>). Vectors will be rejected until the collection is recreated.
                            <div class="mt-2">
                                <button class="btn btn-primary btn-sm" onclick="Config.recreateAndReindex()">Recreate collection &amp; Reindex</button>
                            </div>
                        </div>
                        <div class="card-body">
                            <div id="emb-global-status" class="global-status">
                                <span class="status-dot"></span>
                                <span id="emb-global-text">Loading...</span>
                            </div>
                            <div id="emb-models-list" class="mt-3"></div>
                            <div class="search-row mt-3">
                                <input type="text" id="emb-search-input" placeholder="Search HuggingFace...">
                                <button class="btn btn-primary btn-sm" onclick="Config.searchEmbModel()">Search</button>
                            </div>
                            <div id="emb-search-results" class="search-results mt-3"></div>
                            <div class="form-actions mt-3">
                                <button class="btn btn-primary btn-sm" onclick="Config.downloadEmbModel()" id="btn-download-emb">Download</button>
                                <button class="btn btn-danger btn-sm" onclick="Config.deleteEmbModel()" id="btn-delete-emb">Delete</button>
                            </div>
                        </div>
                    </div>
                    <!-- Sparse model card (SPLADE / transformers) -->
                    <div class="card">
                        <div class="card-header"><h2>Embedding Fast</h2></div>
                        <div class="card-body">
                            <div id="fast-global-status" class="global-status">
                                <span class="status-dot"></span>
                                <span id="fast-global-text">Loading...</span>
                            </div>
                            <div id="fast-models-list" class="mt-3"></div>
                        </div>
                    </div>
                    <!-- LLM Card -->
                    <div class="card">
                        <div class="card-header"><h2>LLM</h2></div>
                        <div class="card-body">
                            <div id="llm-global-status" class="global-status">
                                <span class="status-dot"></span>
                                <span id="llm-global-text">Loading...</span>
                            </div>
                            <div id="llm-models-list" class="mt-3"></div>
                            <div class="search-row mt-3">
                                <input type="text" id="llm-search-input" placeholder="Search HuggingFace...">
                                <button class="btn btn-primary btn-sm" onclick="Config.searchLlmModel()">Search</button>
                            </div>
                            <div id="llm-search-results" class="search-results mt-3"></div>
                            <div class="form-actions mt-3">
                                <button class="btn btn-primary btn-sm" onclick="Config.downloadLlmModel()" id="btn-download-llm">Download</button>
                                <button class="btn btn-danger btn-sm" onclick="Config.deleteLlmModel()" id="btn-delete-llm">Delete</button>
                            </div>
                        </div>
                    </div>
                </div>
            </details>

        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script id="backend-config-data" type="application/json">{{ config_json | safe }}</script>
<script src="{{ url_for('static', path='/js/internal/release-selector.js') }}"></script>
<script src="{{ url_for('static', path='/js/internal/progress-bar.js') }}"></script>
<script src="{{ url_for('static', path='/js/internal/config.js') }}"></script>
{% endblock %}
