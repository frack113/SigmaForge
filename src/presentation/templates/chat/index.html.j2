{% extends "shared/layout.html.j2" %}

{% block title %}Chat — SigmaForge{% endblock %}

{% block body_class %}chat-page{% endblock %}

{% block styles %}
{{ super() }}
<link rel="stylesheet" href="{{ url_for('static', path='/css/pages/chat.css') }}">
{% endblock %}

{% block sidebar %}
<div class="chat-sidebar-actions">
    <button class="btn btn-secondary" id="new-chat-btn" title="Start a new chat">+ New Chat</button>
    <div class="chat-sidebar-group">
        <label class="chat-sidebar-label" for="prompt-select">System Prompt</label>
        <select id="prompt-select" class="chat-sidebar-select">
            <option value="">— Default (none) —</option>
        </select>
    </div>
</div>
{% endblock %}

{% block content %}
<div class="chat-layout">
    <div class="chat-header-bar">
        <span class="chat-header-title">SigmaForge</span>
    </div>
    <div class="chat-messages" id="chat-messages" role="log" aria-live="polite" aria-label="Messages du chat">
        <div class="chat-welcome" id="chat-welcome">
            <h2>SigmaForge</h2>
            <p>Ask questions about Sigma detection rules</p>
        </div>
        <div class="typing-indicator" id="typing-indicator" hidden>
            <span class="typing-dot"></span>
            <span class="typing-dot"></span>
            <span class="typing-dot"></span>
        </div>
    </div>
    <div class="chat-input-bar">
        <form id="chat-form">
            <textarea id="message-input" placeholder="Ask a question about Sigma rules..." rows="1"></textarea>
            <button type="submit" id="send-btn" title="Send">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="22" y1="2" x2="11" y2="13"></line>
                    <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                </svg>
            </button>
        </form>
    </div>
</div>
{% endblock %}

{% block footer %}{% endblock %}

{% block scripts %}
{{ super() }}
<script src="{{ url_for('static', path='/js/external/marked.min.js') }}"></script>
<script src="{{ url_for('static', path='/js/external/dompurify.min.js') }}"></script>
<script>
    window.__INITIAL_PROMPTS = {{ prompts | tojson | safe }};
</script>
<script src="{{ url_for('static', path='/js/internal/chat.js') }}"></script>
{% endblock %}
